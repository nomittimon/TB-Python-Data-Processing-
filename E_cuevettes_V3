# Reihenfolge: Kanal 1..8, überspringe fehlende -> laufender Spalten-Index.
def build_mapping(missing_channels):
    mapping = {}
    counter = 0
    for i in range(anzahl_kanale):
        if i in missing_channels:
            mapping[i] = None
        else:
            mapping[i] = counter
            counter += 1
    return mapping

