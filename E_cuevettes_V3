plot_ec_summary(daten_cv_pre, daten_cv_post, cv_pre_mapping, cv_post_mapping, 'Samples Only: CV', 'CV', xlim=cv_xlim, show_controls=False)
# ==========================================
# 7. DER FINALE MITTELWERT-GRAPH (CHRONO + PHOTO)
# ==========================================
has_fecn = False
for i in range(anzahl_kanale):
    if i not in kanale_ausblenden:
        if photo_mapping_cols[i]['a_420'] is not None and photo_mapping_cols[i]['a_420'] in daten_photometer.columns:
            has_fecn = True
            break

n_proben = len(replikate_idx)

# Erstellt für jeden gewählten Modus eine komplette eigene Grafik
for mode in gui_data['od420_modes']:
    n_subplots = 3 if has_fecn else 2
    fig_final, axes = plt.subplots(n_subplots, 1, figsize=(10, 4 * n_subplots), sharex=True)

    if has_fecn:
        ax1, ax2, ax3 = axes
    else:
        ax1, ax2 = axes
        ax3 = None

    chrono_reps, od600_reps, od420_reps = [], [], []

    for i in replikate_idx:
        c_idx = chrono_mapping.get(i)
        if daten_chrono is not None and c_idx is not None and (c_idx * 2 + 1) in daten_chrono.columns:
            strom_raw = pd.to_numeric(daten_chrono[c_idx * 2 + 1], errors='coerce').copy()
            zc_h = pd.to_numeric(daten_chrono[c_idx * 2], errors='coerce') / 3600
            if i in kanale_abgebrochen:
                cutoff_h = kanale_abgebrochen[i]
                strom_raw.loc[zc_h > cutoff_h] = float('nan')
            if activate_baseline and not strom_raw.dropna().empty:
                baseline = strom_raw.dropna().iloc[:5].mean() if len(strom_raw.dropna()) >= 5 else strom_raw.dropna().iloc[0]
                strom_raw = strom_raw - baseline
            strom_dichte = strom_raw / flaeche_cm2
            chrono_reps.append(strom_dichte)
        
        cols = photo_mapping_cols[i]
        if cols['a_600'] is not None and cols['a_600'] in daten_photometer.columns:
            od600 = pd.to_numeric(daten_photometer[cols['a_600']], errors='coerce')
            od600_reps.append(od600)
            
            if cols['a_420'] is not None and cols['a_420'] in daten_photometer.columns:
                od420_raw = pd.to_numeric(daten_photometer[cols['a_420']], errors='coerce')
                od420_korr = get_od420_corrected(od420_raw, od600, mode)
                od420_reps.append(od420_korr)

    # --- MITTELWERTE & STANDARDABWEICHUNG ---
    if n_proben > 0:
        chrono_df = pd.concat(chrono_reps, axis=1) if chrono_reps else None
        od600_df = pd.concat(od600_reps, axis=1) if od600_reps else None
        od420_df = pd.concat(od420_reps, axis=1) if od420_reps else None
        
        chrono_mean = chrono_df.mean(axis=1) if chrono_df is not None else None
        chrono_std = chrono_df.std(axis=1) if chrono_df is not None else None
        
        od600_mean = od600_df.mean(axis=1) if od600_df is not None else None
        od600_std = od600_df.std(axis=1) if od600_df is not None else None
        
        od420_mean = od420_df.mean(axis=1) if od420_df is not None else None
        od420_std = od420_df.std(axis=1) if od420_df is not None else None

        zeit_chrono_final = None 
        if chrono_mean is not None and daten_chrono is not None:
            chrono_mean = chrono_mean.rolling(window=glaettung_fenster, min_periods=1).median()
            chrono_std = chrono_std.rolling(window=glaettung_fenster, min_periods=1).median()
            erster_chrono_rep = None
            for rep in replikate_idx:
                if chrono_mapping.get(rep) is not None:
                    erster_chrono_rep = rep
                    break
            if erster_chrono_rep is not None:
                zeit_chrono_final = pd.to_numeric(daten_chrono[chrono_mapping[erster_chrono_rep] * 2], errors='coerce') / 3600
                ax1.plot(zeit_chrono_final, chrono_mean, color='black', linewidth=3, label=f'Mean {sample_name} (n={n_proben})')
                ax1.fill_between(zeit_chrono_final, chrono_mean - chrono_std, chrono_mean + chrono_std, color='black', alpha=0.2)

        zeit_photo_final = None
        for rep in replikate_idx:
            if photo_mapping_cols[rep]['t_600'] is not None:
                zeit_photo_final = pd.to_numeric(daten_photometer[photo_mapping_cols[rep]['t_600']], errors='coerce') / 60
                break

        if zeit_photo_final is not None:
            if od600_mean is not None:
                ax2.plot(zeit_photo_final, od600_mean, color='black', linewidth=3, label=f'Mean {sample_name} (n={n_proben})')
                ax2.fill_between(zeit_photo_final, od600_mean - od600_std, od600_mean + od600_std, color='black', alpha=0.2)
            if od420_mean is not None and ax3 is not None:
                ax3.plot(zeit_photo_final, od420_mean, color='black', linewidth=3, label=f'Mean {sample_name} (n={n_proben})')
                ax3.fill_between(zeit_photo_final, od420_mean - od420_std, od420_mean + od420_std, color='black', alpha=0.2)

        # Extremwerte der Basis-Kanäle (Chrono & OD600) nur einmal abspeichern, OD420 pro Mode speichern
        if mode == gui_data['od420_modes'][0]:
            ermittle_extrema(f"Probe ({sample_name}) - Current Density (µA/cm²)", chrono_mean, zeit_chrono_final)
            ermittle_extrema(f"Probe ({sample_name}) - OD 600 nm", od600_mean, zeit_photo_final)
        ermittle_extrema(f"Probe ({sample_name}) - OD 420 nm ({mode})", od420_mean, zeit_photo_final)

    for idx, i in enumerate(kontrollen_idx):
        if i in kanale_ausblenden: 
            continue
        name = kanal_namen.get(i, f"Channel {i+1}")
        farbe = kontroll_farben_map.get(i, 'red')
        
        # Chrono Kontrolle
        c_idx = chrono_mapping.get(i)
        if daten_chrono is not None and c_idx is not None and (c_idx * 2 + 1) in daten_chrono.columns and i != kanal_ohne_strom:
            strom_raw = pd.to_numeric(daten_chrono[c_idx * 2 + 1], errors='coerce').copy()
            zc = pd.to_numeric(daten_chrono[c_idx * 2], errors='coerce') / 3600
            if i in kanale_abgebrochen:
                cutoff_h = kanale_abgebrochen[i]
                strom_raw.loc[zc > cutoff_h] = float('nan')
            if activate_baseline and not strom_raw.dropna().empty:
                baseline = strom_raw.dropna().iloc[:5].mean() if len(strom_raw.dropna()) >= 5 else strom_raw.dropna().iloc[0]
                strom_raw = strom_raw - baseline
            strom_eval = strom_raw / flaeche_cm2
            strom_smoothed = strom_eval.rolling(window=glaettung_fenster, min_periods=1).median()
            ax1.plot(zc, strom_smoothed, color=farbe, linewidth=1.5, linestyle='--', label=name)
            if mode == gui_data['od420_modes'][0]:
                ermittle_extrema(f"Control '{name}' - Current Density (µA/cm²)", strom_smoothed, zc)
        
        # Photometer Kontrolle
        cols = photo_mapping_cols[i]
        if cols['t_600'] is not None and cols['a_600'] in daten_photometer.columns:
            zp = pd.to_numeric(daten_photometer[cols['t_600']], errors='coerce') / 60
            od600 = pd.to_numeric(daten_photometer[cols['a_600']], errors='coerce')
            ax2.plot(zp, od600, color=farbe, linewidth=1.5, linestyle='--', label=name)
            if mode == gui_data['od420_modes'][0]:
                ermittle_extrema(f"Control '{name}' - OD 600 nm", od600, zp)
            
            if cols['a_420'] is not None and cols['a_420'] in daten_photometer.columns:
                od420_raw = pd.to_numeric(daten_photometer[cols['a_420']], errors='coerce')
                od420_korr = get_od420_corrected(od420_raw, od600, mode)
                if ax3 is not None:
                    ax3.plot(zp, od420_korr, color=farbe, linewidth=1.5, linestyle='--', label=name)
                ermittle_extrema(f"Control '{name}' - OD 420 nm ({mode})", od420_korr, zp)

    ax1.set_ylabel('Current Density\n(µA/cm²)', fontsize=11)
    ax2.set_ylabel(r'Optical Density' + '\n' + r'(OD$_{600}$)', fontsize=11)

    achsen_liste = [ax1, ax2]
    if ax3 is not None:
        ax3.set_ylabel(get_od420_ylabel(mode), fontsize=11)
        ax3.set_xlabel('Time [h]', fontsize=12)
        ax3.xaxis.set_major_locator(MultipleLocator(4))
        ax3.xaxis.set_minor_locator(MultipleLocator(1))
        achsen_liste.append(ax3)
    else:
        ax2.set_xlabel('Time [h]', fontsize=12)
        ax2.xaxis.set_major_locator(MultipleLocator(4))
        ax2.xaxis.set_minor_locator(MultipleLocator(1))

    for ax in achsen_liste:
        ax.grid(True, linestyle=':', alpha=0.4)
        ax.legend(loc='center left', bbox_to_anchor=(1, 0.5), fontsize=10)

    ax1.text(-0.12, 1.05, 'A', transform=ax1.transAxes, fontsize=14, fontweight='bold')
    ax2.text(-0.12, 1.05, 'B', transform=ax2.transAxes, fontsize=14, fontweight='bold')
    if ax3 is not None:
        ax3.text(-0.12, 1.05, 'C', transform=ax3.transAxes, fontsize=14, fontweight='bold')

    plt.tight_layout()
    pfad_final = os.path.join(output_ordner, f"{datei_datum}Summary_Means_{mode}.png")
    plt.savefig(pfad_final, dpi=600, bbox_inches='tight')
    plt.close(fig_final)

