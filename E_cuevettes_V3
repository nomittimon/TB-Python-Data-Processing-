def ermittle_volt_range(daten_liste, mapping_liste, puffer=0.2):
    v_min_global, v_max_global = float('inf'), float('-inf')
    for daten, mapping in zip(daten_liste, mapping_liste):
        if daten is None:
            continue
        for i in range(anzahl_kanale):
            if i in kanale_ausblenden:
                continue
            c_idx = mapping.get(i)
            if c_idx is None:
                continue
            col_v = c_idx * 2
            if col_v in daten.columns:
                v = pd.to_numeric(daten[col_v], errors='coerce').dropna()
                if not v.empty:
                    v_min_global = min(v_min_global, v.min())
                    v_max_global = max(v_max_global, v.max())
    if v_min_global == float('inf') or v_max_global == float('-inf'):
        return None
    return (v_min_global - puffer, v_max_global + puffer)

