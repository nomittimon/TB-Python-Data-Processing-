summary_lines = [f"Extremwerte fuer Probe: {sample_name} und Kontrollen", "="*40]

def ermittle_extrema_volt(name_str, y_daten, x_volt, xlim=None):
    if y_daten is not None and not y_daten.dropna().empty and x_volt is not None:
        clean_y = y_daten.dropna()
        valid_idx = clean_y.index
        clean_x = x_volt.loc[valid_idx]

        if xlim:
            mask = (clean_x >= xlim[0]) & (clean_x <= xlim[1])
            clean_y = clean_y[mask]
            clean_x = clean_x[mask]

        if clean_y.empty:
            return

        summary_lines.append(f"\n--- {name_str} ---")

        y_array = clean_y.values
        signal_range = clean_y.max() - clean_y.min()
        min_prom = signal_range * 0.05 if signal_range > 0 else 0.01

        peaks, _ = find_peaks(y_array, prominence=min_prom, width=2)
        if len(peaks) > 0:
            summary_lines.append("Gefundene Hochpunkte (Maxima):")
            for p in peaks:
                max_val = y_array[p]
                volt_max = clean_x.iloc[p]
                summary_lines.append(f"  -> {max_val:.4f} µA/cm² (bei V = {volt_max:.4f} V)")
        else:
            max_val = clean_y.max()
            volt_max = clean_x.loc[clean_y.idxmax()]
            summary_lines.append(f"Globaler Hochpunkt: {max_val:.4f} µA/cm² (bei V = {volt_max:.4f} V)")

        troughs, _ = find_peaks(-y_array, prominence=min_prom, width=2)
        if len(troughs) > 0:
            summary_lines.append("Gefundene Tiefpunkte (Minima):")
            for t in troughs:
                min_val = y_array[t]
                volt_min = clean_x.iloc[t]
                summary_lines.append(f"  -> {min_val:.4f} µA/cm² (bei V = {volt_min:.4f} V)")
        else:
            min_val = clean_y.min()
            volt_min = clean_x.loc[clean_y.idxmin()]
            summary_lines.append(f"Globaler Tiefpunkt: {min_val:.4f} µA/cm² (bei V = {volt_min:.4f} V)")

def ermittle_extrema(name_str, daten_series, zeit_series):
    if daten_series is not None and not daten_series.dropna().empty and zeit_series is not None:
        clean_daten = daten_series.dropna()
        valid_idx = clean_daten.index
        clean_zeit = zeit_series.loc[valid_idx]
        
        start_val = clean_daten.iloc[0]
        start_idx = clean_daten.index[0]
        zeit_start = clean_zeit.loc[start_idx]

        max_val = clean_daten.max()
        max_idx = clean_daten.idxmax()
        zeit_max = clean_zeit.loc[max_idx] if max_idx in clean_zeit.index else float('nan')

        min_val = clean_daten.min()
        min_idx = clean_daten.idxmin()
        zeit_min = clean_zeit.loc[min_idx] if min_idx in clean_zeit.index else float('nan')

        summary_lines.append(f"\n--- {name_str} ---")
        summary_lines.append(f"Startwert:        {start_val:.4f}  (bei t = {zeit_start:.2f} h)")
        summary_lines.append(f"Hochpunkt (Max):  {max_val:.4f}  (bei t = {zeit_max:.2f} h)")
        summary_lines.append(f"Tiefpunkt (Min):  {min_val:.4f}  (bei t = {zeit_min:.2f} h)")

