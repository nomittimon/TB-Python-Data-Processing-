    cols_c2 = photo_mapping_cols.get(ctrl2_idx)
    
    if cols_c2 and cols_c2['a_600'] is not None and cols_c2['a_420'] is not None:
        od600_c2 = pd.to_numeric(daten_photometer[cols_c2['a_600']], errors='coerce')
        od420_c2 = pd.to_numeric(daten_photometer[cols_c2['a_420']], errors='coerce')
        
        # NaNs und extrem kleine OD-Werte filtern (verhindert Division durch Null)
        valid_mask = od600_c2.notna() & od420_c2.notna() & (od600_c2 > 0.05)
        
        if valid_mask.any():
            od600_clean = od600_c2[valid_mask]
            od420_clean = od420_c2[valid_mask]
            
            # Dynamisch Linear (Polynom 1. Grades): OD420_störung = m * OD600 + b
            poly_coeffs = np.polyfit(od600_clean, od420_clean, 1)
            use_dynamic_sl = True
            print(f"Dynamischer Streulichtfaktor (Linear) aktiv. Steigung und Offset: {poly_coeffs}")
        else:
            print("Zu wenig gültige Daten in Kontrolle 2. Nutze statischen Fallback.")

def get_od420_corrected(od420_raw, od600_series, mode):
    """Berechnet die gewählte OD420 Variante."""
    if mode == 'raw':
        return od420_raw
    elif mode == 'norm':
        # Verhindere Division durch 0
        safe_od600 = od600_series.replace(0, np.nan)
        ratio = od420_raw / safe_od600
        # Ersten Messpunkt (Index 0) auf NaN setzen, damit er ignoriert wird
        if len(ratio) > 0:
            ratio.iloc[0] = np.nan
        return ratio
    elif mode == 'dyn_lin' and use_dynamic_sl:
        return od420_raw - np.polyval(poly_coeffs, od600_series)
    else:
        # Fallback (statisch linear, angewendet für 'linear' oder fehlendes 'dyn_lin')
        return od420_raw - (streulicht_faktor * od600_series)

def get_od420_ylabel(mode):
    if mode == 'raw': return r'FeCN' + '\n' + r'(OD$_{420}$ Raw)'
    if mode == 'norm': return r'OD$_{420}$ / OD$_{600}$'
    if mode == 'dyn_lin': return r'FeCN' + '\n' + r'(OD$_{420}$ Dyn. Linear)'
    # Schreibt den individuellen Faktor direkt in den Graphen
    return r'FeCN' + '\n' + f'(OD$_{{420}}$ Statisch {streulicht_faktor})'
