def parse_eingabe(eingabe_str):
    if not eingabe_str:
        return []
    teile = str(eingabe_str).replace(';', ',').replace(' ', '').split(',')
    indizes = []
    for t in teile:
        if t.isdigit():
            val = int(t)
            if 1 <= val <= 8:
                indizes.append(val - 1)
    return indizes

def parse_abgebrochen(eingabe_str):
    if not eingabe_str:
        return {}
    teile = str(eingabe_str).replace(';', ',').replace(' ', '').split(',')
    abgebrochen_dict = {}
    for t in teile:
        if ':' in t:
            try:
                k_str, m_str = t.split(':')
                val = int(k_str.strip())
                min_val = float(m_str.strip())
                if 1 <= val <= 8:
                    abgebrochen_dict[val - 1] = min_val
            except ValueError:
                pass
    return abgebrochen_dict

