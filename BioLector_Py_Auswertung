            lag, td = berechne_kinetik_empfehlung(pd.Series(common_time[valid_idx]), pd.Series(mean_vals[valid_idx]))
            
            max_val_anzeige = np.mean(daten_max[grp]) if daten_max[grp] else 0.0
            
            f.write(f"{grp:<35} | {max_val_anzeige:<10.3f} | {f'{max_t:.2f} h':<12} | {f'{lag:.2f} h' if lag else 'N/A':<12} | {f'{td:.2f} h' if td else 'N/A':<15} | {np.mean(grp_auc) if grp_auc else 0:<10.2f}\n")
            
        f.write("\n\n")

        # --- STATISTIK ---
        for test_type, title, is_corrected in [
            ("inner", "I: MUTANTEN VS. KONTROLLE (Holm-Bonferroni korrigiert)", True),
            ("cross", "II: EINFLUSS DES MEDIATORS PRO STAMM (unkorrigiert)", False)
        ]:
            f.write(f"=== STATISTISCHE AUSWERTUNG {title} ===\n\n")
            
            for metrik_name in ["End-Yield (Max Signal)", "Fläche unter der Kurve (AUC)"]:
                f.write(f"--- PARAMETER: {metrik_name} ---\n")
                
                for med in (gruppen_nach_mediator.keys() if test_type == "inner" else ["FeCN", "ABTS", "PMS", "PES"]):
                    gruppen = gruppen_nach_mediator[med]
                    if not gruppen: continue
                    
                    if test_type == "inner":
                        cond_control = next((g for g in gruppen if 'dns' in g.lower() or 'wt' in g.lower()), None)
                        if not cond_control or cond_control not in daten_max: continue
                        f.write(f"\n*) Bedingung: {med} (Vergleich vs. Kontrolle: {cond_control})\n")
                        targets = [(cond_control, g) for g in gruppen if g != cond_control]
                    else:
                        f.write(f"\n*) Einfluss von {med} auf die jeweiligen Stämme\n")
                        targets = []
                        for med_grp in gruppen:
                            base_search = med_grp.replace(med, "").replace("__", "_").strip("_")
                            base_grp = next((g for g in gruppen_nach_mediator["No Redox-Mediator"] if base_search.lower() in g.lower() or g.lower() in base_search.lower()), None)
                            if base_grp: targets.append((base_grp, med_grp))
                    
                    raw_p_values, gefunden = {}, False
                    for control, mutant in targets:
                        if control in daten_max and mutant in daten_max and len(daten_max[control]) > 1 and len(daten_max[mutant]) > 1:
                            
                            if metrik_name == "End-Yield (Max Signal)":
                                val_ctrl, val_mut = daten_max[control], daten_max[mutant]
                            else:
                                t_sync = max(group_start_times[control], group_start_times[mutant])
                                val_ctrl = get_sync_auc(control, t_sync, ch)
                                val_mut = get_sync_auc(mutant, t_sync, ch)
                                
                            if len(val_ctrl) > 1 and len(val_mut) > 1:
                                _, p_val = stats.ttest_ind(val_ctrl, val_mut, equal_var=False, nan_policy='omit')
                                raw_p_values[mutant if test_type == "inner" else f"{control} vs. {mutant}"] = (p_val, control, mutant)
                                gefunden = True
                    
                    if not gefunden: f.write("  Keine Vergleiche möglich.\n")
                    elif test_type == "inner":
                        for mutante, (p, adj, sig) in holm_bonferroni({k: v[0] for k, v in raw_p_values.items()}).items():
                            f.write(f"  {cond_control} vs. {mutante:<30}: p-Wert = {p:.4f} (Holm-Limit: {adj:.4f}) -> {sig}\n")
                    else:
                        for name, (p_val, ctrl, mut) in raw_p_values.items():
                            f.write(f"  {name:<45}: p-Wert = {p_val:.4f} -> {'Signifikant *' if p_val < 0.05 else 'n.s.'}\n")
                f.write("\n" + "="*60 + "\n\n")

print(f"\nFertig! Alle Graphen und Statistik-Dateien wurden im Ordner '{output_ordner}' gespeichert.")