def berechne_kinetik_empfehlung(zeit_series, od_series, window_size=7): 
    od_smooth = od_series.rolling(window=3, center=True, min_periods=1).mean()
    if od_smooth.isna().all(): return None, None
    max_od = od_smooth.max()
    basis_od_linear = max(0.005, od_smooth.dropna().iloc[:5].mean()) 
    y_0_log = np.log(basis_od_linear)
    
    mask = (od_smooth >= max(0.05, basis_od_linear + 0.04)) & (od_smooth <= max_od * 0.75)
    if mask.sum() < window_size:
        mask = od_smooth > (basis_od_linear + 0.02)
        if mask.sum() < window_size: return None, None
            
    t, y = zeit_series[mask].values, od_smooth[mask].values
    ln_y = np.log(np.maximum(y, 1e-6))
    
    mu_max, best_intercept = 0, 0
    for i in range(len(t) - window_size + 1):
        slope, intercept, r, _, _ = stats.linregress(t[i:i+window_size], ln_y[i:i+window_size])
        if slope > mu_max and r**2 > 0.95 and y[i+window_size-1] > y[i] * 1.20:
            mu_max, best_intercept = slope, intercept
            
    if mu_max == 0:
        for i in range(len(t) - window_size + 1):
            slope, intercept, r, _, _ = stats.linregress(t[i:i+window_size], ln_y[i:i+window_size])
            if slope > mu_max and r**2 > 0.85 and y[i+window_size-1] > y[i] * 1.15:
                mu_max, best_intercept = slope, intercept

    if mu_max <= 0: return None, None
    return max(0, (y_0_log - best_intercept) / mu_max), np.log(2) / mu_max

def holm_bonferroni(p_values_dict, alpha=0.05):
    sorted_tests = sorted(p_values_dict.items(), key=lambda x: x[1])
    return {name: (p_val, alpha / (len(sorted_tests) - rank), "Signifikant *" if p_val < (alpha / (len(sorted_tests) - rank)) else "n.s.") for rank, (name, p_val) in enumerate(sorted_tests)}

def get_sync_auc(grp_name, t_sync, ch_name):
    aucs = []
    mask = common_time >= t_sync
    # GEÄNDERT: Greift jetzt auf die maskierten Plot-Daten zu
    for arr in master_data_plot[ch_name][grp_name]:
        valid = ~np.isnan(arr) & mask
        if np.any(valid): aucs.append(np.trapezoid(arr[valid], common_time[valid]))
    return aucs

