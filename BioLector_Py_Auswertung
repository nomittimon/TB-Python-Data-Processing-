def format_group_name(grp):
    if not grp.startswith("Vnat_"):
        return grp
    
    parts = grp.split("_")
    
    # Zur Sicherheit, falls WT vorkommt (kein Delta)
    if "wt" in grp.lower():
        if len(parts) >= 3:
            return rf"$\mathit{{V.\ natriegens}}$ {parts[1]} WT"
        return rf"$\mathit{{V.\ natriegens}}$ WT"
        
    # Für Mutanten (z.B. Vnat_FeCN_MtrC -> V. natriegens FeCN ΔmtrC)
    if len(parts) >= 3:
        mediator = parts[1]
        gen = "_".join(parts[2:])
        # Großes Mtr zu kleinem mtr korrigieren
        gen = gen.replace("Mtr", "mtr")
        return rf"$\mathit{{V.\ natriegens}}$ $\Delta\mathit{{{gen}}}$ {mediator}"
    
    # Für Mutanten ohne Mediator (z.B. Vnat_MtrAB -> V. natriegens ΔmtrAB)
    elif len(parts) == 2:
        gen = parts[1]
        # Großes Mtr zu kleinem mtr korrigieren
        gen = gen.replace("Mtr", "mtr")
        return rf"$\mathit{{V.\ natriegens}}$ $\Delta\mathit{{{gen}}}$"
        
    return grp


